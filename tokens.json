{
  "$description": "Sip & Tell design tokens. Two themes share one structure: day (The Day Café, 6AM–6PM) and moon (The Moon Saloon, 6PM–6AM).",
  "color": {
    "day": {
      "page": {
        "$value": "#F1EBDF"
      },
      "card": {
        "$value": "#FCFAF5"
      },
      "track": {
        "$value": "#E8E1D2"
      },
      "ink": {
        "$value": "#15141B"
      },
      "muted": {
        "$value": "#76706B"
      },
      "accent": {
        "$value": "#53A8CA",
        "$description": "The one Day blue for fills, outlines, tints and blue text. 2.3:1 on page cream, 2.6:1 on card, below WCAG AA for text (designer's choice)."
      },
      "on-accent": {
        "$value": "#15141B",
        "$description": "Ink on solid accent, 5:1."
      }
    },
    "moon": {
      "page": {
        "$value": "#15141B"
      },
      "card": {
        "$value": "#21202B"
      },
      "track": {
        "$value": "#2E2C38"
      },
      "ink": {
        "$value": "#F6F1E5"
      },
      "muted": {
        "$value": "#9C96A0"
      },
      "accent": {
        "$value": "#FF4FA3"
      },
      "on-accent": {
        "$value": "#15141B"
      }
    },
    "shared": {
      "error": {
        "$value": "#FF5F6D"
      },
      "mark-neutral": {
        "$value": "#BDB4CC"
      }
    },
    "tints": {
      "$description": "Tints are their own variables in Figma (Color collection) so opacity can't get lost.",
      "accent-60": "accent @ 60% (hero arch, illustration cards, answer bars, 2nd popup tag)",
      "accent-30": "accent @ 30% (3rd popup tag, selected answers, disabled Next)",
      "accent-10": "accent @ 10%",
      "ink-15": "ink @ 15% (progress track)",
      "ink-10": "ink @ 10% (field + unselected card outlines)",
      "track-60": "track @ 60% (story placeholders)",
      "error-10": "error @ 12% (error banner)"
    }
  },
  "opacity": {
    "accent-100": {
      "$value": 1
    },
    "accent-60": {
      "$value": 0.6,
      "$description": "Hero and illustration cards. Keep ink text on top."
    },
    "accent-30": {
      "$value": 0.3
    },
    "accent-10": {
      "$value": 0.1
    }
  },
  "font": {
    "family": {
      "display": {
        "$value": "'Tenor Sans', serif"
      },
      "italic": {
        "$value": "'EB Garamond', serif"
      },
      "body": {
        "$value": "'Cutive', serif"
      },
      "mono": {
        "$value": "'DM Mono', monospace"
      }
    },
    "style": {
      "location-title": {
        "family": "display",
        "size": 86,
        "lineHeight": 0.95,
        "letterSpacing": "-0.02em",
        "iconSize": 70,
        "$description": "Space name on the home hero only (\"the day café\" / \"the moon saloon\"); sun or moon icon sits after the last word."
      },
      "display": {
        "family": "display",
        "size": 72,
        "lineHeight": 1.0,
        "letterSpacing": "-0.02em"
      },
      "header": {
        "family": "display",
        "size": 50,
        "lineHeight": 1.1,
        "letterSpacing": "-0.02em"
      },
      "wordmark": {
        "family": "display",
        "size": 30,
        "lineHeight": "normal",
        "letterSpacing": "-0.02em"
      },
      "header-italic": {
        "family": "italic",
        "size": 30,
        "lineHeight": 1.25,
        "style": "italic"
      },
      "inline-italic": {
        "family": "italic",
        "size": 22,
        "lineHeight": 1.3,
        "style": "italic",
        "$description": "Used inside Cutive body copy."
      },
      "body": {
        "family": "body",
        "size": 15,
        "lineHeight": 1.6
      },
      "mono": {
        "family": "mono",
        "size": 15,
        "lineHeight": "normal",
        "$description": "Lists, ingredients, steps, values."
      },
      "meta": {
        "family": "mono",
        "size": 13,
        "lineHeight": "normal",
        "letterSpacing": "0.06em",
        "textTransform": "uppercase",
        "$description": "Labels, nav, tags, captions."
      }
    },
    "mobile": {
      "$description": "Mobile (390) sizes. Same roles as desktop.",
      "wordmark": 20,
      "location-title": 70,
      "location-icon": 60,
      "display": 30,
      "header": 30,
      "header-italic": 24,
      "inline-italic": 18,
      "body": 12,
      "mono": 10,
      "meta": 10
    }
  },
  "space": {
    "$description": "Semantic spacing; Figma Spacing collection has Desktop and Mobile modes.",
    "tight": {
      "desktop": 4,
      "mobile": 4
    },
    "group": {
      "desktop": 10,
      "mobile": 10
    },
    "item": {
      "desktop": 20,
      "mobile": 15
    },
    "section": {
      "desktop": 30,
      "mobile": 20
    },
    "block": {
      "desktop": 50,
      "mobile": 20
    },
    "gutter": {
      "desktop": 80,
      "mobile": 30
    }
  },
  "layout": {
    "page-max": 1440,
    "content-max": 1280,
    "gutter": {
      "desktop": 80,
      "tablet": 40,
      "mobile": 30
    },
    "section-gap": {
      "desktop": 50,
      "mobile": 20
    },
    "breakpoint": {
      "mobile": 390,
      "tablet": 768,
      "desktop": 1200
    }
  },
  "radius": {
    "card": 24,
    "inner": 16,
    "pill": 999
  },
  "stroke": {
    "hairline": 1,
    "accent": 2
  },
  "mark": {
    "icon": 230,
    "core": 100,
    "core-blur": 5
  },
  "separator": " / "
}